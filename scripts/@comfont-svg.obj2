@絵文字
--label:テキスト装飾
--information:comfont_svg.aux2で指定サイズのカラー字形を画像化するサンプルです。サイズはemのピクセル数です。
--track0:サイズ,1,512,96,1
--string@text:comfont-svg::絵文字,🇯🇵
--string@font:comfont-svg::フォント,Twitter Color Emoji
local svg = obj.module("comfont_svg")
local path, w, h, x, baseline, advance, err = svg.rasterize_glyph(text, font, obj.track0)
if not path then error(err or "絵文字を画像化できません") end
if not obj.load("image", path) then error("絵文字画像を読み込めません") end

@SVGサンプル
--label:テキスト装飾
--information:同じSVGを指定ピクセル数で再ラスタライズするサンプルです。
--track0:サイズ,1,512,96,1
local svg = obj.module("comfont_svg")
local xml = [[<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 36 36"><circle cx="18" cy="18" r="17" fill="#ffcc4d"/><circle cx="12" cy="14" r="2" fill="#664500"/><circle cx="24" cy="14" r="2" fill="#664500"/><path d="M9 22 Q18 32 27 22" fill="none" stroke="#664500" stroke-width="2" stroke-linecap="round"/></svg>]]
local path, w, h, x, baseline, advance, err = svg.rasterize_svg(xml, obj.track0, obj.track0)
if not path then error(err or "SVGを画像化できません") end
if not obj.load("image", path) then error("SVG画像を読み込めません") end
