テキスト=<?local settings={\n    id="",      -- セリフ準備のキャラクターID、または "L3" のようなレイヤー指定\n    profile="default", -- 合成フォントエディターで保存したプロファイル名\n}\nlocal id,profile=settings.id,settings.profile\nlocal voice=require("PSDToolKit.VoiceStates"):get(id)\nlocal restart_time=voice\n    and math.max(0,obj.time-(tonumber(voice.time) or 0))\n    or 0\nlocal wait_tag=string.format("<w%.9f>",restart_time)\nlocal compositefont=obj.module("compositefont")\nlocal font,size,_,_,_,_,_,spacing=obj.getfont()\nlocal use_layout=compositefont.api_version()>=9\nrequire("PSDToolKit").mes({\n    id=id,\n    modifier=function(text)\n        local decorated\n        if use_layout then\n            decorated=compositefont.decorate_layout(text,profile,size,spacing,font)\n        else\n            decorated=compositefont.decorate(text,profile,size,spacing)\n        end\n        return wait_tag..decorated\n    end,\n},obj)\n?>
