テキスト=<?local settings={\n    id="", -- セリフ準備のキャラクターID、または "L3" のようなレイヤー指定\n}\n-- プロファイルは後段の「描画@comfont」効果で指定する。\nlocal id=settings.id\nlocal voice=require("PSDToolKit.VoiceStates"):get(id)\nlocal restart_time=voice\n    and math.max(0,obj.time-(tonumber(voice.time) or 0))\n    or 0\nlocal wait_tag=string.format("<w%.9f>",restart_time)\nlocal ok,compositefont=pcall(obj.module,"compositefont")\nlocal source=obj.getvalue("テキスト","テキスト")\nlocal capture=ok and compositefont and compositefont.api_version()>=14\n    and type(source)=="string"\nlocal function submit(text)\n    if capture then\n        pcall(compositefont.capture_text,text,tostring(obj.id),obj.frame,source)\n    end\nend\n-- セリフがないフレームも空の本文を渡し、前回の結果を残さない。\nsubmit("")\nrequire("PSDToolKit").mes({\n    id=id,\n    modifier=function(text)\n        -- 表示速度0専用。すでに経過した先頭waitタグは通常表示だけに残す。\n        submit(text)\n        return wait_tag..text\n    end,\n},obj)?>
