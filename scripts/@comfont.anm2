@パイプ
--label:テキスト装飾
-- 設定欄なし。明示連携済みの本文を優先し、なければ保存原文を収集する。
local ok, cf = pcall(obj.module, "compositefont")
if not ok or not cf or cf.api_version() < 15 then return end
local raw = obj.getvalue("テキスト", "テキスト")
if type(raw) ~= "string" or #raw > 65536 then return end
local id, frame = tostring(obj.id), obj.frame
local text, producer, source = cf.generated_text(id, frame, raw)
if type(text) == "string" then
    if type(producer) ~= "string" then return end
    local found, current = pcall(obj.getvalue, producer, "スクリプト")
    if found and current == source then return end
end
if not cf.forget_text(id, frame) then return end
text = cf.decode_text(raw)
-- 本文内のLuaを再実行したり、別オブジェクトのグローバル変数を拾ったりしない。
if text:find("<?", 1, true) then return end
cf.capture_text(text, id, frame, raw)

@描画
--label:テキスト装飾
--string@profile:comfont::プロファイル,default
--check@disable_ligatures:comfont::リガチャを強制解除,false
-- 原文は標準テキストに保持。制御文字は描画用にだけ生成し、書き戻さない。
if type(profile) ~= "string" or profile == "" then return end
local ok, module = pcall(obj.module, "compositefont")
if not ok or not module or module.api_version() < 14 then return end
local function value(item) return obj.getvalue("テキスト", item) end
local function enabled(item)
    local v = value(item)
    return v == true or v == 1 or v == "1"
end
-- 未対応の設定はホストの通常表示を維持する。
if obj.num ~= 1 or enabled("文字毎に個別オブジェクト") or enabled("自動スクロール")
    or enabled("移動座標上に表示") or (tonumber(value("表示速度")) or 0) ~= 0 then return end
local alignments = {
    ["左寄せ[上]"] = 0, ["中央揃え[上]"] = 1, ["右寄せ[上]"] = 2,
    ["左寄せ[中]"] = 3, ["中央揃え[中]"] = 4, ["右寄せ[中]"] = 5,
    ["左寄せ[下]"] = 6, ["中央揃え[下]"] = 7, ["右寄せ[下]"] = 8,
}
local align = alignments[value("文字揃え")]
local decoration = value("文字装飾")
if align == nil or (decoration and decoration ~= "標準文字") then return end
local raw, font = value("テキスト"), value("フォント")
if type(raw) ~= "string" or #raw > 65536 or type(font) ~= "string" then return end
local size = tonumber(value("サイズ"))
local spacing = tonumber(value("字間")) or 0
if not size or size < 1 or size > 512 then return end
local decoded, original = pcall(module.decode_text, raw)
if not decoded then return end
-- スクリプト制御はこの効果より前へ置く。本文スクリプトも再実行しない。
local captured, generated, producer, producer_source = pcall(module.generated_text, tostring(obj.id), obj.frame, raw)
if captured and type(producer) == "string" then
    -- 無効化・削除・コード変更後は、その生成元の古い結果を使わない。
    local found, current = pcall(obj.getvalue, producer, "スクリプト")
    if not found or current ~= producer_source then generated = nil end
end
local has_generated = captured and type(generated) == "string"
if has_generated then
    original = generated -- 生成本文はalias表現ではないので再復号しない。
elseif original:find("<?", 1, true) then
    return -- 連携されていないLua本文はホストの通常表示を維持する。
end
local force = disable_ligatures == true or disable_ligatures == 1 or disable_ligatures == "1"
local decorated_ok, display_text = pcall(module.decorate, original, profile, size / 2, spacing)
if not decorated_ok or type(display_text) ~= "string" then return end
if display_text == original then
    if not force and not has_generated then return end
    -- 空の装飾でも解除は有効。ただし存在しないプロファイルは通常表示へ戻す。
    local found = false
    for _, name in ipairs(module.profile_names()) do
        if name == profile then found = true; break end
    end
    if not found then return end
end
-- 描画側はプロファイルを参照せず、生成済み制御文字列を一度だけ解釈する。
local rendered, image = pcall(module.render_decorated, display_text, font, size, spacing,
    tonumber(value("行間")) or 0, value("文字色") or "ffffff", align, enabled("B"), enabled("I"), force)
if not rendered or not image then return end
-- 同期アップロード完了まで画像の所有権を持つuserdataを保持する。
obj.putpixeldata("object", image.data, image.width, image.height, "bgra")
obj.cx = (align % 3 - 1) * image.width / 2
obj.cy = (math.floor(align / 3) - 1) * image.height / 2
