@CompositeFont Resolve Verification

local compositefont = obj.module("compositefont")
local entries = {
    {"A", "U+0041"},
    {"B", "U+0042"},
    {"C", "U+0043"},
    {"日", "U+65E5"},
    {"本", "U+672C"},
    {"語", "U+8A9E"},
    {"1", "U+0031"},
    {"2", "U+0032"},
    {"3", "U+0033"},
}

if obj.frame == 0 and compositefont.api_version() >= 4 then
    local decorated = compositefont.decorate(
        "国LINE123国",
        "integration-test",
        96,
        0
    )
    print("@info", "[compositefont-decorate-test] " .. decorated)
end

local ox = 0
obj.multiobject(#entries, function()
    local entry = entries[obj.index + 1]
    local character = entry[1]
    local font, size_ratio, baseline_shift_em, tracking_adjust_em,
        vertical_scale_ratio, horizontal_scale_ratio, category, rule_id =
        compositefont.resolve(character, "integration-test")

    obj.setfont(
        font,
        96 * size_ratio,
        3,
        0xffffff,
        0x202020,
        false,
        false,
        96 * tracking_adjust_em,
        0
    )
    local applied_font, applied_size = obj.getfont()
    obj.load("text", character)
    obj.sx = horizontal_scale_ratio
    obj.sy = vertical_scale_ratio
    obj.ox = ox
    obj.oy = 96 * baseline_shift_em
    ox = ox + obj.w * horizontal_scale_ratio
    if obj.index + 1 < #entries then
        ox = ox + 96 * tracking_adjust_em
    end

    if obj.frame == 0 then
        print(
            "@info",
            string.format(
                "[compositefont-test] %s %s category=%s rule=%s resolved=%s applied=%s size=%.1f tracking=%.1f%% vertical=%.0f%% horizontal=%.0f%% glyph=%dx%d",
                entry[2],
                character,
                category,
                rule_id,
                font,
                applied_font,
                applied_size,
                tracking_adjust_em * 100,
                vertical_scale_ratio * 100,
                horizontal_scale_ratio * 100,
                obj.w,
                obj.h
            )
        )
    end
end)
obj.ox = -ox / 2
