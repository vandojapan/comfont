テキスト=<?local settings={\n    profile="default", -- 合成フォントエディターで保存したプロファイル名\n    text=[=[ここにテキストを入力]=],\n}\nlocal text,profile=settings.text,settings.profile\nlocal compositefont=obj.module("compositefont")\nlocal font,size,_,_,_,_,_,spacing=obj.getfont()\nif compositefont.api_version()>=9 then\n    obj.mes(compositefont.decorate_layout(text,profile,size,spacing,font))\nelse\n    obj.mes(compositefont.decorate(text,profile,size,spacing))\nend\n?>
