テキスト=<?local compositefont=obj.module("compositefont")\nlocal api=compositefont.api_version()\nlocal font,size,_,_,_,_,_,spacing=obj.getfont()\nlocal function apply(text)\n    return compositefont.decorate_layout(text,"integration-test",size,spacing,font)\nend\nlocal function has(text,needle)\n    return string.find(text,needle,1,true)~=nil\nend\nlocal function count(text,needle)\n    local total,pos=0,1\n    while true do\n        local found=string.find(text,needle,pos,true)\n        if not found then return total end\n        total=total+1\n        pos=found+#needle\n    end\nend\nlocal color_source="国<#ff0000>LINE<#>123"\nlocal size_source="<s120>国LINE<s>123"\nlocal font_source="<@Yu Gothic UI>国LINE<@>"\nlocal unknown_source="<future-control>国"\nlocal color=apply(color_source)\nlocal sized=apply(size_source)\nlocal fonted=apply(font_source)\nlocal unknown=apply(unknown_source)\nlocal twice=apply(color)\nlocal color_ok=color~=color_source and has(color,"<#ff0000>") and has(color,"<#>")\nlocal size_ok=sized~=size_source and has(sized,"<s120>") and has(sized,"<s>")\nlocal font_ok=fonted~=font_source and count(fonted,"<@") == 2 and has(fonted,"<@Yu Gothic UI>") and has(fonted,"<gw")\nlocal unknown_ok=unknown==unknown_source\nlocal idempotent_ok=twice==color\nlocal passed=api>=10 and color_ok and size_ok and font_ok and unknown_ok and idempotent_ok\nif obj.frame==0 then\n    local level=passed and "@info" or "@error"\n    print(level,string.format("[compositefont-basic-tags-standard] %s api=%d color=%s size=%s font=%s unknown=%s idempotent=%s",passed and "PASS" or "FAIL",api,tostring(color_ok),tostring(size_ok),tostring(font_ok),tostring(unknown_ok),tostring(idempotent_ok)))\n    print(level,"[compositefont-basic-tags-standard] color="..color)\n    print(level,"[compositefont-basic-tags-standard] size="..sized)\n    print(level,"[compositefont-basic-tags-standard] font="..fonted)\nend\nobj.mes(color.."\\n"..sized.."\\n"..fonted)\n?>
